+bool ap_sta_mld_set_unauthorized(struct hostapd_data *assoc_hapd,
+				 struct sta_info *assoc_sta)
+{
+	struct hostapd_data *other_hapd;
+	struct sta_info *other_sta;
+	bool authorized = false;
+
+	for_each_mld_link(other_hapd, assoc_hapd) {
+		if (other_hapd == assoc_hapd)
 			continue;
 
-		wpa_printf(MSG_DEBUG, "Removing link station from MLD " MACSTR,
-			   MAC2STR(prev->addr));
-		ap_sta_link_event(hapd, WPA_EVENT_LINK_STA_REMOVED, prev->addr,
-				  hapd->mld_link_id);
-		assoc_sta = hostapd_ml_get_assoc_sta(hapd, prev, &assoc_hapd);
-		ap_free_link_sta(hapd, prev);
-		if (assoc_sta && assoc_sta != prev)
-			hostapd_ubus_notify_sta_links(assoc_hapd, assoc_sta);
+		other_sta = hostapd_mld_partner_sta(other_hapd, assoc_sta);
+		if (other_sta &&
+		    ap_sta_set_authorized_flag(other_hapd, other_sta, 0))
+			authorized = true;
+	}
