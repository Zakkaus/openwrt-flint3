+ * non-AP MLD that took the AID after the association STA went. NULL when no
+ * such station exists. */
+static struct sta_info * hostapd_mld_assoc_sta(struct hostapd_data *hapd,
+					       struct sta_info *sta,
+					       struct hostapd_data **assoc_hapd)
 {
-	struct hostapd_data *assoc_hapd;
-	struct sta_info *sta, *prev, *assoc_sta;
+	struct hostapd_data *other_hapd;
+	struct sta_info *other_sta;
 
-	sta = hapd->sta_list;
-	while (sta) {
-		prev = sta;
-		sta = sta->next;
+	if (!hostapd_sta_is_link_sta(hapd, sta)) {
+		*assoc_hapd = hapd;
+		return sta;
+	}
+
+	other_hapd = hostapd_mld_get_link_bss(hapd, sta->mld_assoc_link_id);
+	if (!other_hapd)
+		return NULL;
+
+	other_sta = ap_get_sta(other_hapd, sta->addr);
+	if (!ap_sta_is_mld(other_hapd, other_sta) ||
+	    hostapd_sta_is_link_sta(other_hapd, other_sta))
+		return NULL;
 
-		if (!hostapd_sta_is_link_sta(hapd, prev))
+	*assoc_hapd = other_hapd;
+	return other_sta;
