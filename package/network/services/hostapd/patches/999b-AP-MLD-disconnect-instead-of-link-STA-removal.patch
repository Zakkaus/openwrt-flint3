+/* The driver removes the link station with the station of the non-AP MLD */
+static void hostapd_free_mld_link_sta(struct hostapd_data *hapd,
+				      struct sta_info *sta)
+{
+	sta->skip_link_sta_remove = 1;
+	ap_free_sta(hapd, sta);
+}
+
+
+/* Whether sta and lsta of lhapd are entries of the same association
+ * of a non-AP MLD whose association STA is gone */
+static bool hostapd_mld_same_orphan(struct sta_info *sta,
+				    struct hostapd_data *lhapd,
+				    struct sta_info *lsta)
+{
+	return lsta == sta ||
+		(ap_sta_is_mld(lhapd, lsta) &&
+		 hostapd_sta_is_link_sta(lhapd, lsta) &&
+		 lsta->mld_assoc_link_id == sta->mld_assoc_link_id);
+}
+
+
+/* The association STA of the non-AP MLD of sta is gone, e.g. freed alone, so
+ * entries of the association can remain on any link of the AP MLD. Free them
+ * all and delete the kernel station once: the earlier removal of the
+ * association STA may have skipped its NL80211_CMD_DEL_STATION
+ * (driver_ap_teardown, skip_kernel_delete), and a station left with peers on
+ * the link is what crashes ath12k at the link removal, while a delete of a
+ * station that is already gone only fails. An entry of another association of
+ * the same address owns the kernel station, so then nothing goes to the
+ * driver. */
+static void hostapd_disconnect_orphan_mld(struct hostapd_data *hapd,
+					  struct sta_info *sta, bool deauth)
+{
+	struct hostapd_data *other_hapd;
+	struct sta_info *other_sta;
+	bool authorized = false, other_assoc = false;
+	u8 addr[ETH_ALEN];
+
+	os_memcpy(addr, sta->addr, ETH_ALEN);
+	for_each_mld_link(other_hapd, hapd) {
+		other_sta = ap_get_sta(other_hapd, addr);
+		if (!other_sta)
+			continue;
+		if (!hostapd_mld_same_orphan(sta, other_hapd, other_sta))
+			other_assoc = true;
+		else if (ap_sta_set_authorized_flag(other_hapd, other_sta, 0))
+			authorized = true;
+	}
+
+	wpa_printf(MSG_DEBUG,
+		   "MLD: Disconnect " MACSTR " left on link_id=%u without its association link_id=%u%s",
+		   MAC2STR(addr), hapd->mld_link_id, sta->mld_assoc_link_id,
+		   other_assoc ? ", associated again" : "");
+
+	/* ap_free_sta() of the association STA cleared the authorization on
+	 * every link when it reported the disconnection */
+	if (!other_assoc && authorized)
+		ap_sta_set_authorized_event(hapd, sta, 0);
+	if (!other_assoc && deauth)
+		hostapd_drv_sta_deauth(hapd, addr, WLAN_REASON_DEAUTH_LEAVING);
+
+	for_each_mld_link(other_hapd, hapd) {
+		if (other_hapd == hapd)
+			continue;
+
+		other_sta = ap_get_sta(other_hapd, addr);
+		if (other_sta &&
+		    hostapd_mld_same_orphan(sta, other_hapd, other_sta))
+			hostapd_free_mld_link_sta(other_hapd, other_sta);
+	}
+	hostapd_free_mld_link_sta(hapd, sta);
+
+	if (!other_assoc)
+		hostapd_drv_sta_remove(hapd, addr);
+}
+
+
+/* ath12k cannot remove one link of a non-AP MLD: it keeps the firmware peer
+ * of the link station that NL80211_CMD_REMOVE_LINK_STA removes, and the vdev
+ * delete of the link then times out and crashes the firmware. End the
+ * association of the non-AP MLD that holds the link of hapd instead, whichever
+ * link it associated on, with one NL80211_CMD_DEL_STATION, so that the driver
+ * deletes the whole station, with its peers on every link, before the link
+ * goes. The delete is sent also with driver_ap_teardown: the AP teardown of
+ * the driver would remove only the stopped link from the station, the same
+ * link station removal. The entries on each link are freed without a kernel
+ * call. With deauth, the Deauthentication frame goes out first. */
+static void hostapd_disconnect_link_mld(struct hostapd_data *hapd,
+					struct sta_info *sta, bool deauth)
+{
+	struct hostapd_data *assoc_hapd, *other_hapd;
+	struct sta_info *assoc_sta, *other_sta;
+	u8 addr[ETH_ALEN];
+
+	assoc_sta = hostapd_mld_assoc_sta(hapd, sta, &assoc_hapd);
+	if (!assoc_sta) {
+		hostapd_disconnect_orphan_mld(hapd, sta, deauth);
+		return;
+	}
+
+	os_memcpy(addr, sta->addr, ETH_ALEN);
+	wpa_printf(MSG_DEBUG,
+		   "MLD: Disconnect " MACSTR " from link_id=%u, association link_id=%u",
+		   MAC2STR(addr), hapd->mld_link_id, assoc_hapd->mld_link_id);
+	if (deauth)
+		hostapd_drv_sta_deauth(assoc_hapd, addr,
+				       WLAN_REASON_DEAUTH_LEAVING);
+	ap_sta_mld_set_unauthorized(assoc_hapd, assoc_sta);
+
+	/* The station on the association link goes last, as in
+	 * ap_free_sta_all_links(): its ap_free_sta() frees the state machine
+	 * that the other links share. The kernel station goes before it, as
+	 * __ap_free_sta() would delete it, ahead of a VLAN removal. */
+	if (sta != assoc_sta)
+		hostapd_free_mld_link_sta(hapd, sta);
+	for_each_mld_link(other_hapd, assoc_hapd) {
+		if (other_hapd == hapd || other_hapd == assoc_hapd)
+			continue;
+
+		other_sta = hostapd_mld_partner_sta(other_hapd, assoc_sta);
+		if (other_sta)
+			hostapd_free_mld_link_sta(other_hapd, other_sta);
 	}
+	hostapd_drv_sta_remove(assoc_hapd, addr);
+	assoc_sta->skip_kernel_delete = 1;
+	ap_free_sta(assoc_hapd, assoc_sta);
+}
+
+
+static void hostapd_disconnect_link_mlds(struct hostapd_data *hapd,
+					 bool link_sta_only, bool deauth)
+{
+	struct sta_info *sta;
+
+	if (!hapd->conf->mld_ap || !hapd->mld)
+		return;
+
+	/* Each call frees the entries of one non-AP MLD, on every link, and
+	 * always the one in this list */
+	for (;;) {
+		for (sta = hapd->sta_list; sta; sta = sta->next) {
+			if (link_sta_only ? hostapd_sta_is_link_sta(hapd, sta) :
+			    ap_sta_is_mld(hapd, sta))
+				break;
+		}
+		if (!sta)
+			break;
+
+		hostapd_disconnect_link_mld(hapd, sta, deauth);
+	}
+}
+
+
+/* Every non-AP MLD that holds the link as a non-association link */
+void hostapd_free_link_stas(struct hostapd_data *hapd)
+{
+	hostapd_disconnect_link_mlds(hapd, true, true);
+}
+
+
+/* Every non-AP MLD that holds the link. Without deauth, no frame goes out:
+ * the caller sent its own, or sends none. */
+void hostapd_free_link_mlds(struct hostapd_data *hapd, bool deauth)
+{
+	hostapd_disconnect_link_mlds(hapd, false, deauth);
 }
