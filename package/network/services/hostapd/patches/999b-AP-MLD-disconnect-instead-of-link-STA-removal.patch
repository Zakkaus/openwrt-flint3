+/* The station of the non-AP MLD of assoc_sta on the link of hapd */
+static struct sta_info * hostapd_mld_partner_sta(struct hostapd_data *hapd,
+						 struct sta_info *assoc_sta)
+{
+	struct sta_info *sta = ap_get_sta(hapd, assoc_sta->addr);
+
+	if (sta == assoc_sta || !ap_sta_is_mld(hapd, sta) ||
+	    sta->mld_assoc_link_id != assoc_sta->mld_assoc_link_id)
+		return NULL;
+
+	return sta;
+}
